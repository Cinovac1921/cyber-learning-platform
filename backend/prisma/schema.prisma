generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "mysql"
}

enum Role {
  STUDENT
  INSTRUCTOR
  ADMIN
}

/// Who may browse a course. PUBLIC shows in the public library; TEMPLATE is starter content kept out of
/// students' sight; CLASSROOM is private to the members of one classroom.
enum CourseScope {
  PUBLIC
  TEMPLATE
  CLASSROOM
}

/// Where a public-library course stands. NONE: a draft nobody has submitted. PENDING: waiting for an admin.
/// APPROVED: live. REJECTED: sent back with a note. Only APPROVED public courses are ever shown to students.
enum ReviewStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
}

enum NotificationType {
  COURSE_SUBMITTED
  COURSE_APPROVED
  COURSE_REJECTED
  COURSE_TAKEN_DOWN
}

enum CourseLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum ChallengeCategory {
  NETWORK_ANALYSIS
  FORENSICS
  WEB
  REVERSE_ENGINEERING
  CRYPTOGRAPHY
}

enum ChallengeDifficulty {
  EASY
  MEDIUM
  HARD
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  displayName  String
  role         Role     @default(STUDENT)
  /// Login tokens carry the number they were issued under. Raising it signs the account out everywhere.
  tokenVersion Int      @default(0)
  courses      Course[] @relation("CourseAuthor")
  reviewedCourses Course[] @relation("CourseReviewer")
  progress     LessonProgress[]
  attempts     Attempt[]
  challenges   Challenge[]
  challengeSolves ChallengeSolve[]
  classrooms   Classroom[]
  memberships  ClassroomMember[]
  passwordResetTokens PasswordResetToken[]
  notifications Notification[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("users")
}

model Course {
  id        Int         @id @default(autoincrement())
  title     String      @db.VarChar(120)
  slug      String      @unique @db.VarChar(120)
  summary   String      @db.VarChar(300)
  level     CourseLevel @default(BEGINNER)
  published Boolean     @default(false)
  scope     CourseScope @default(PUBLIC)
  /// Only set for CLASSROOM courses.
  classroom   Classroom?  @relation(fields: [classroomId], references: [id], onDelete: Restrict)
  classroomId Int?
  author    User        @relation("CourseAuthor", fields: [authorId], references: [id])
  authorId  Int
  reviewStatus ReviewStatus @default(NONE)
  /// The admin's reason when a course is rejected or taken down.
  reviewNote   String?      @db.VarChar(500)
  submittedAt  DateTime?
  reviewedAt   DateTime?
  reviewer     User?        @relation("CourseReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedById Int?
  /// Set when the course was made by copying another one from the library.
  copiedFrom   Course?      @relation("CourseCopies", fields: [copiedFromId], references: [id], onDelete: SetNull)
  copiedFromId Int?
  copies       Course[]     @relation("CourseCopies")
  lessons   Lesson[]
  assessments Assessment[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([authorId])
  @@index([classroomId])
  @@index([reviewStatus])
  @@index([reviewedById])
  @@index([copiedFromId])
  @@map("courses")
}

/// Something a person should know about, such as their course being approved. It belongs to one person only.
model Notification {
  id        Int              @id @default(autoincrement())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  type      NotificationType
  message   String           @db.VarChar(500)
  /// Where clicking it goes, inside the app.
  link      String           @db.VarChar(200)
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@map("notifications")
}

/// A one-time link that lets someone choose a new password. Only a hash of the token is stored,
/// so a leaked database can't be used to reset anyone's password.
model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  tokenHash String   @unique @db.VarChar(64)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

/// A group of students run by one instructor. Its courses are private to its members.
model Classroom {
  id          Int      @id @default(autoincrement())
  owner       User     @relation(fields: [ownerId], references: [id])
  ownerId     Int
  name        String   @db.VarChar(120)
  description String   @default("") @db.VarChar(300)
  /// The random code students type to join, stored without the dash.
  joinCode    String   @unique @db.VarChar(16)
  /// The instructor can close joining without removing anyone.
  joinOpen    Boolean  @default(true)
  members     ClassroomMember[]
  courses     Course[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([ownerId])
  @@map("classrooms")
}

model ClassroomMember {
  id          Int       @id @default(autoincrement())
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  classroomId Int
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      Int
  joinedAt    DateTime  @default(now())

  @@unique([classroomId, userId])
  @@index([userId])
  @@map("classroom_members")
}

model Lesson {
  id        Int      @id @default(autoincrement())
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId  Int
  position  Int
  title     String   @db.VarChar(160)
  content   String   @db.Text
  /// Hidden lessons are invisible to students but still editable by the instructor.
  visible   Boolean  @default(true)
  progress  LessonProgress[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([courseId, position])
  @@map("lessons")
}

model LessonProgress {
  id          Int      @id @default(autoincrement())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      Int
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  lessonId    Int
  completedAt DateTime @default(now())

  @@unique([userId, lessonId])
  @@index([lessonId])
  @@map("lesson_progress")
}
/// A quiz that belongs to one course. Students only see it once it is published.
model Assessment {
  id          Int        @id @default(autoincrement())
  course      Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId    Int
  title       String     @db.VarChar(120)
  description String     @default("") @db.VarChar(300)
  passPercent Int        @default(70)
  published   Boolean    @default(false)
  questions   Question[]
  attempts    Attempt[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([courseId])
  @@map("assessments")
}

/// One multiple-choice question. Exactly one of its options is correct.
model Question {
  id           Int            @id @default(autoincrement())
  assessment   Assessment     @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  assessmentId Int
  position     Int
  prompt       String         @db.VarChar(500)
  explanation  String         @default("") @db.VarChar(500)
  options      Option[]
  answers      AttemptAnswer[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@unique([assessmentId, position])
  @@map("questions")
}

model Option {
  id         Int             @id @default(autoincrement())
  question   Question        @relation(fields: [questionId], references: [id], onDelete: Cascade)
  questionId Int
  position   Int
  text       String          @db.VarChar(250)
  isCorrect  Boolean         @default(false)
  answers    AttemptAnswer[]

  @@unique([questionId, position])
  @@map("options")
}

/// One time a student submitted a quiz. Score and pass mark are stored as they were then.
model Attempt {
  id           Int             @id @default(autoincrement())
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       Int
  assessment   Assessment      @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  assessmentId Int
  correct      Int
  total        Int
  percent      Int
  passed       Boolean
  answers      AttemptAnswer[]
  createdAt    DateTime        @default(now())

  @@index([userId, assessmentId])
  @@index([assessmentId])
  @@map("attempts")
}

model AttemptAnswer {
  id         Int       @id @default(autoincrement())
  attempt    Attempt   @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  attemptId  Int
  question   Question  @relation(fields: [questionId], references: [id], onDelete: Cascade)
  questionId Int
  option     Option?   @relation(fields: [optionId], references: [id], onDelete: SetNull)
  optionId   Int?
  isCorrect  Boolean

  @@unique([attemptId, questionId])
  @@index([questionId])
  @@index([optionId])
  @@map("attempt_answers")
}


/// A capture-the-flag challenge. The flag is never stored as text: only a salted hash of it.
model Challenge {
  id          Int                 @id @default(autoincrement())
  author      User                @relation(fields: [authorId], references: [id])
  authorId    Int
  title       String              @db.VarChar(120)
  category    ChallengeCategory
  difficulty  ChallengeDifficulty @default(EASY)
  points      Int                 @default(100)
  description String              @db.Text
  hint        String              @default("") @db.VarChar(500)
  flagSalt    String              @db.VarChar(32)
  flagHash    String              @db.VarChar(64)
  /// The file students download, if any. fileKey is a random name on disk, never the original name.
  fileKey     String?             @db.VarChar(64)
  fileName    String?             @db.VarChar(200)
  fileSize    Int?
  published   Boolean             @default(false)
  solves      ChallengeSolve[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([authorId])
  @@index([category])
  @@map("challenges")
}

/// One student solving one challenge. Points are copied here so editing a challenge later does not change old scores.
model ChallengeSolve {
  id          Int       @id @default(autoincrement())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      Int
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  challengeId Int
  points      Int
  createdAt   DateTime  @default(now())

  @@unique([userId, challengeId])
  @@index([challengeId])
  @@map("challenge_solves")
}

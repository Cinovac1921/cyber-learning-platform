# Copy this file to .env and fill in your own values. Never commit the real .env.

# MySQL or MariaDB connection: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/cyber_learning"

# Secret used to sign login tokens. Make a long random one with: openssl rand -hex 32
JWT_SECRET="change-me"

# Where the frontend runs (allowed by CORS)
FRONTEND_ORIGIN="http://localhost:5173"

# Port the backend listens on
PORT=3000

# Optional: where uploaded challenge files are stored (default: backend/uploads)
# UPLOAD_DIR="/absolute/path/to/uploads"

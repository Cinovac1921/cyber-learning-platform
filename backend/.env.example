# Copy this file to .env and fill in your own values. Never commit the real .env.

# MySQL or MariaDB connection: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/cyber_learning"

# Secret used to sign login tokens. Make a long random one with: openssl rand -hex 32
JWT_SECRET="change-me"

# Where the frontend runs (allowed by CORS)
FRONTEND_ORIGIN="http://localhost:5173"

# Port the backend listens on
PORT=3000

# Optional: where uploaded challenge files are stored (default: backend/uploads)
# UPLOAD_DIR="/absolute/path/to/uploads"

# Forgot-password emails. Leave SMTP_HOST empty while developing: the reset link is then
# printed in the backend terminal instead of being emailed. In production, set all of these.
# Any SMTP service works (Brevo, Mailtrap, Gmail with an app password, ...).
# SMTP_HOST="smtp.example.com"
# SMTP_PORT=587
# SMTP_USER="your-smtp-username"
# SMTP_PASS="your-smtp-password"
# MAIL_FROM="Cyber Learning <no-reply@example.com>"

# Public address of the frontend, used to build the link in reset emails (default: FRONTEND_ORIGIN)
# APP_URL="http://localhost:5173"
